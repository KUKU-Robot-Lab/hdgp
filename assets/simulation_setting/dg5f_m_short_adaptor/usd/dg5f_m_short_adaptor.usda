#usda 1.0
(
    defaultPrim = "DG5FMShortAdaptor"
    metersPerUnit = 1
    upAxis = "Z"
    doc = "DG-5F M short adaptor plate, from Fusion rl_ws/simulation setting/DG5F-M-Short-adaptor. Meters, Z-up. Origin = bottom mounting face centre. Threads removed; same mesh as the STL/DAE."
)

def Xform "DG5FMShortAdaptor" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    bool physics:rigidBodyEnabled = 1
