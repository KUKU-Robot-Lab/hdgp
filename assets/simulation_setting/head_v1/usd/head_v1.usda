#usda 1.0
(
    defaultPrim = "HeadV1"
    metersPerUnit = 1
    upAxis = "Z"
    doc = "Pan-tilt head with Intel RealSense D435i, from Fusion rl_ws/simulation setting/head_v1. Meters, Z-up. 4 links, 2 revolute + 1 fixed joint."
)

def Xform "HeadV1" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    bool physxArticulation:enabledSelfCollisions = 0
    def Scope "Looks"
    {
        def Material "BlackSoftTouchPlastic"
        {
            token outputs:surface.connect = </HeadV1/Looks/BlackSoftTouchPlastic/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0706, 0.0706, 0.0706)
                float inputs:metallic = 0.00
                float inputs:roughness = 0.844
                token outputs:surface
            }
        }
        def Material "DarkGreySatinFinishPlastic"
        {
            token outputs:surface.connect = </HeadV1/Looks/DarkGreySatinFinishPlastic/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2980, 0.2980, 0.2980)
                float inputs:metallic = 0.00
                float inputs:roughness = 0.900
                token outputs:surface
            }
        }
        def Material "Generic_CBD2EF"
        {
            token outputs:surface.connect = </HeadV1/Looks/Generic_CBD2EF/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7961, 0.8235, 0.9373)
                float inputs:metallic = 0.00
                float inputs:roughness = 0.844
                token outputs:surface
            }
        }
        def Material "GreenHighGlossPlastic"
        {
            token outputs:surface.connect = </HeadV1/Looks/GreenHighGlossPlastic/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2863, 0.6627, 0.3294)
                float inputs:metallic = 0.00
                float inputs:roughness = 0.800
                token outputs:surface
            }
        }
        def Material "MatteAluminum"
        {
            token outputs:surface.connect = </HeadV1/Looks/MatteAluminum/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1.0000, 1.0000, 1.0000)
                float inputs:metallic = 0.00
                float inputs:roughness = 0.950
                token outputs:surface
            }
        }
        def Material "Mirror"
        {
            token outputs:surface.connect = </HeadV1/Looks/Mirror/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6745, 0.6745, 0.6745)
                float inputs:metallic = 0.00
                float inputs:roughness = 0.844
                token outputs:surface
            }
        }
        def Material "PaintedMetal000000"
        {
            token outputs:surface.connect = </HeadV1/Looks/PaintedMetal000000/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0000, 0.0000, 0.0000)
                float inputs:metallic = 1.00
                float inputs:roughness = 0.080
                token outputs:surface
            }
        }
        def Material "PolishedZinc"
        {
            token outputs:surface.connect = </HeadV1/Looks/PolishedZinc/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8000, 0.8078, 0.8000)
                float inputs:metallic = 0.00
                float inputs:roughness = 0.844
                token outputs:surface
            }
        }
        def Material "TranslucentPlastic"
        {
            token outputs:surface.connect = </HeadV1/Looks/TranslucentPlastic/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5137, 0.5137, 0.5137)
                float inputs:metallic = 0.00
                float inputs:roughness = 0.844
                float inputs:opacity = 0.100
                token outputs:surface
            }
        }
    }
    def Xform "base_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        bool physics:rigidBodyEnabled = 1
        float physics:mass = 0.0638629
        point3f physics:centerOfMass = (0.00713269, 6.7569e-06, 0.00936326)
        float3 physics:diagonalInertia = (2.3536e-05, 4.01065e-05, 4.22733e-05)
        quatf physics:principalAxes = (0.987410, 0.002385, -0.158163, 0.000562)
        def Scope "Visuals"
        {
            def Mesh "PaintedMetal000000" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
