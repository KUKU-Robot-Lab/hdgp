    def PhysicsFixedJoint "root_joint"
    {
        rel physics:body1 = </HeadV1/base_link>
    }
    def PhysicsRevoluteJoint "pan_joint" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        rel physics:body0 = </HeadV1/base_link>
        rel physics:body1 = </HeadV1/pan_link>
        uniform token physics:axis = "Z"
        point3f physics:localPos0 = (0.0225, 3.4e-05, 0.035603)
        point3f physics:localPos1 = (0.0225, 3.4e-05, 0.035603)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = -90
        float physics:upperLimit = 90
        float drive:angular:physics:targetPosition = 0
        float drive:angular:physics:stiffness = 100
        float drive:angular:physics:damping = 10
        float drive:angular:physics:maxForce = 2
    }
    def PhysicsRevoluteJoint "tilt_joint" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        rel physics:body0 = </HeadV1/pan_link>
        rel physics:body1 = </HeadV1/tilt_link>
        uniform token physics:axis = "Y"
        point3f physics:localPos0 = (0.0225, -0.011546, 0.066003)
        point3f physics:localPos1 = (0.0225, -0.011546, 0.066003)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = -90
        float physics:upperLimit = 90
        float drive:angular:physics:targetPosition = 0
        float drive:angular:physics:stiffness = 100
        float drive:angular:physics:damping = 10
        float drive:angular:physics:maxForce = 2
    }
    def PhysicsFixedJoint "camera_joint"
    {
        rel physics:body0 = </HeadV1/tilt_link>
        rel physics:body1 = </HeadV1/camera_link>
        point3f physics:localPos0 = (0, 0, 0)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
    }
}
