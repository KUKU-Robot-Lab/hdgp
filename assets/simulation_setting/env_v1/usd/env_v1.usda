#usda 1.0
(
    defaultPrim = "EnvV1"
    metersPerUnit = 1
    upAxis = "Z"
    doc = "Generated from Fusion rl_ws/simulation setting/env_v1. Meters, Z-up. Single rigid body; per-appearance visual meshes; one merged collision mesh."
)

def Xform "EnvV1" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    bool physics:rigidBodyEnabled = 1
    bool physics:kinematicEnabled = 1
    float physics:mass = 17.004
    def Scope "Looks"
    {
        def Material "Generic_B2B2B2"
        {
            token outputs:surface.connect = </EnvV1/Looks/Generic_B2B2B2/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6980, 0.6980, 0.6980)
                float inputs:metallic = 0.00
                float inputs:roughness = 0.800
                token outputs:surface
            }
        }
        def Material "Metal_999999"
        {
            token outputs:surface.connect = </EnvV1/Looks/Metal_999999/Shader.outputs:surface>
