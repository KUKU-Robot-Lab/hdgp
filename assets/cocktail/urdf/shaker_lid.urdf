<?xml version="1.0"?>
<!--
  Cocktail shaker LID as an independent rigid body. ORIGIN = center of mass.
  Visual = OBJ, Collision = STL. Mesh paths relative to this URDF. mm -> scale 0.001.

  Assembly: when closed, place this lid at (0,0,0.09126) in the BODY frame
  (= body_COM to lid_COM). Mating fit: skirt inner Ø88.7 over body top Ø88 (18mm overlap).
  Set collision approximation = "sdf" in Isaac (hollow shell + Ø4 strainer holes).
-->
<robot name="cocktail_shaker_lid">
  <link name="shaker_lid">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>  <!-- origin = center of mass -->
      <mass value="0.1776"/>
      <inertia ixx="1.8023e-04" ixy="0" ixz="0" iyy="1.8023e-04" iyz="0" izz="2.6513e-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/visual/shaker_lid.obj" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/collision/shaker_lid.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
</robot>
