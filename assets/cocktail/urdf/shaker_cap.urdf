<?xml version="1.0"?>
<!--
  Cocktail shaker CAP as an independent rigid body. ORIGIN = center of mass.
  Visual = OBJ, Collision = STL. Mesh paths relative to this URDF. mm -> scale 0.001.

  Assembly: when closed, place this cap at (0,0,0.12815) in the BODY frame
  (= (0,0,0.03689) in the LID frame). Fit inner Ø57.6 over the lid neck Ø57.
-->
<robot name="cocktail_shaker_cap">
  <link name="shaker_cap">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>  <!-- origin = center of mass -->
      <mass value="0.0583"/>
      <inertia ixx="2.9110e-05" ixy="0" ixz="0" iyy="2.9110e-05" iyz="0" izz="4.6322e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/visual/shaker_cap.obj" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/collision/shaker_cap.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
</robot>
